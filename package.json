{
  "name": "c5-loteria",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "C5 — Loteria com Retenção. Fundação de dados (Fase B): PostgreSQL, ledger de dupla entrada, motor de retenção isolado.",
  "scripts": {
    "migrate": "tsx db/migrate.ts up",
    "migrate:status": "tsx db/migrate.ts status",
    "seed:config": "tsx db/seed/0001_seed_engine_config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
