    "restore": "bash infra/restore.sh"
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "dotenv": "^17.2.3",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "@types/pg": "^8.15.6",
    "tsx": "^4.19.1",
    "typescript": "5.6.3",
    "vitest": "^2.1.4"
  }
}
