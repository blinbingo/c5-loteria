# C5 — variáveis de ambiente (NÃO commitar o .env real)
# O código NÃO acopla a nenhum hostname: o domínio é definido só no nginx/infra.

# Banco (Postgres próprio do C5, isolado do influcriator)
DATABASE_URL=postgres://c5_app:CHANGE_ME@127.0.0.1:5433/c5

# Servidor (porta própria do C5 — NÃO usar a 3001 do influcriator)
PORT=3002

# Segredos (gerar valores fortes; nunca versionar)
SESSION_SECRET=CHANGE_ME_LONG_RANDOM
# 2FA/admin, chaves de pagamento etc. entram aqui nas fases seguintes.

NODE_ENV=production
