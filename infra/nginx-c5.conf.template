# C5 — server block do nginx. O HOSTNAME não é acoplado ao código: entra aqui
# via __SERVER_NAME__ no provisionamento (defina C5_SERVER_NAME quando tiver o
# domínio/subdomínio). Enquanto não houver domínio, __SERVER_NAME__ = "_".
server {
    listen 80;
    server_name __SERVER_NAME__;

    # (TLS/Let's Encrypt é adicionado depois com certbot; até lá, HTTP.)
    location / {
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
